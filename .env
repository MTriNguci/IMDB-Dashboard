# Cấu hình kết nối Trino
# Sao chép file này thành .env và điền thông tin kết nối của bạn

# Địa chỉ host của Trino server
TRINO_HOST=192.168.255.217

# Port của Trino server (mặc định: 8080)
TRINO_PORT=8889

# Tên người dùng để kết nối
TRINO_USER=trino

# Catalog name (mặc định: hive)
TRINO_CATALOG=delta

# Schema name (mặc định: default)
TRINO_SCHEMA=lakehouse

# Mật khẩu (nếu cần)
TRINO_PASSWORD=

# HTTP scheme (http hoặc https)
TRINO_HTTP_SCHEME=http

# Verify SSL certificate (true/false)
TRINO_VERIFY=false

# Request timeout (giây)
TRINO_REQUEST_TIMEOUT=10

# Query timeout settings
TRINO_QUERY_MAX_RUN_TIME=1h
TRINO_QUERY_MAX_EXECUTION_TIME=1h
TRINO_QUERY_MAX_PLANNING_TIME=10m
