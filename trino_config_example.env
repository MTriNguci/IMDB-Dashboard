# Cấu hình kết nối Trino cho IMDB Dashboard
# Sao chép file này thành .env và điền thông tin kết nối của bạn
# Dashboard sẽ sử dụng delta.lakehouse làm nguồn dữ liệu chính thay vì đọc CSV

# Địa chỉ host của Trino server
TRINO_HOST=localhost

# Port của Trino server (mặc định: 8889)
TRINO_PORT=8889

# Tên người dùng để kết nối
TRINO_USER=trino

# Catalog name (mặc định: delta)
TRINO_CATALOG=delta

# Schema name (mặc định: lakehouse)
TRINO_SCHEMA=lakehouse

# Mật khẩu (nếu cần)
TRINO_PASSWORD=

# HTTP scheme (http hoặc https)
TRINO_HTTP_SCHEME=http

# Verify SSL certificate (true/false)
TRINO_VERIFY=true

# Request timeout (giây)
TRINO_REQUEST_TIMEOUT=30

# Query timeout settings
TRINO_QUERY_MAX_RUN_TIME=1h
TRINO_QUERY_MAX_EXECUTION_TIME=1h
TRINO_QUERY_MAX_PLANNING_TIME=10m

# Lưu ý: Dashboard sẽ tự động fallback về CSV nếu không kết nối được Trino
# Dashboard sẽ tự động load tất cả các bảng có sẵn trong delta.lakehouse:
# - areaunit, asset, company, dim_area, dim_date, dim_device, dim_vehicle
# - event, eventinfor, eventtype, fact_lpd, factory, handytalkiegps
# - history, intersection, lpr_table, monitoringhistory, rpdaily
# - silver_lpr, stg_lpr_table, test_asset, test_info, vehicles
# 
# Dashboard sẽ sử dụng:
# - vehicles table làm movies data
# - asset table làm series data
# - Các bảng khác cho splits data
